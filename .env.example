# Supabase (login e banco de dados) — crie um projeto gratuito em supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só usada no servidor, para excluir contas (Settings > API > service_role). NUNCA exponha publicamente
# nem coloque em variável que comece com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (aconselhamento por IA)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Limite de mensagens de chat por pessoa por dia
DAILY_LIMIT=40
