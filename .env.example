# Banco de dados Postgres (local, Docker, ou qualquer provedor gerenciado)
DATABASE_URL=postgres://usuario:senha@localhost:5432/lampada

# Chave secreta do Better Auth — gere com: openssl rand -base64 32
AUTH_SECRET=

# URL pública onde o app roda (usada para montar o link do e-mail)
AUTH_URL=http://localhost:3000

# Envio de e-mail (link mágico de login). Se deixar em branco, o link aparece
# só no log do servidor — útil para testar sozinho, sem configurar SMTP.
# Formato: smtp://usuario:senha@host:porta
EMAIL_SERVER=
EMAIL_FROM=Lâmpada <lampada@localhost>

# Anthropic (aconselhamento por IA)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Limite de mensagens de chat por pessoa por dia
DAILY_LIMIT=40
